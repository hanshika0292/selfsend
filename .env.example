# SelfSend reads plain environment variables. Docker Compose loads this file as `.env`;
# for local runs use `node --env-file=.env src/server.ts` or export the variables yourself.

# --- Core ----------------------------------------------------------------------
# Public HTTPS URL of this server, used in tracking and unsubscribe links and as the SNS endpoint.
PUBLIC_URL=https://mail.example.com
# Hostname Caddy gets a TLS certificate for (read by docker-compose.yml only).
DOMAIN=mail.example.com
# Dashboard login password; the dashboard stays disabled while this is empty.
ADMIN_PASSWORD=change-me
# Mail transport: ses | smtp | log (log sends nothing and writes .eml files to data/outbox/; it is the default when unset).
MAIL_TRANSPORT=ses
# HTTP port the server listens on.
PORT=3000
# SQLite database file, created on first start (docker-compose.yml sets /app/data/selfsend.db).
DATABASE_PATH=./data/selfsend.db
# Key that signs tracking links, unsubscribe links and dashboard sessions; generated and stored in the database when empty.
APP_SECRET=

# --- Amazon SES ----------------------------------------------------------------
# AWS region of your SES account.
AWS_REGION=us-east-1
# Access key ID of the IAM user for SES (leave empty to use another AWS SDK credential source, such as an instance role).
AWS_ACCESS_KEY_ID=
# Secret access key of the same IAM user.
AWS_SECRET_ACCESS_KEY=
# SES configuration set that publishes delivery, bounce and complaint events; printed by `npm run cli -- setup-ses`.
SES_CONFIGURATION_SET=
# Accept SNS messages only from this topic, e.g. arn:aws:sns:us-east-1:123456789012:selfsend-events; printed by setup-ses.
SES_SNS_TOPIC_ARN=

# --- SMTP alternative (MAIL_TRANSPORT=smtp) ------------------------------------
# SMTP connection URL, e.g. smtps://user:password@smtp.example.com:465.
SMTP_URL=

# --- Sending -------------------------------------------------------------------
# Maximum number of emails handed to the transport per second.
SEND_RATE_PER_SECOND=10
# Attempts before an email that keeps hitting temporary errors is marked failed.
MAX_SEND_ATTEMPTS=5
# Set to false to allow sending from domains that are not verified (not recommended).
REQUIRE_VERIFIED_DOMAIN=true
# Postal address added to broadcast footers (CAN-SPAM requires one for marketing email).
COMPANY_ADDRESS=

# --- Dashboard cost estimate (display only) ------------------------------------
# SES price per 1,000 emails, in USD.
SES_PRICE_PER_1000=0.10
# Fixed monthly hosting cost, in USD.
FIXED_MONTHLY_COST=6
